# Optional when the dashboard should call the Nest API directly.
# The current dashboard also ships with same-origin local API routes for dev fallback.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api

# Optional override if you want server components to hit a different backend URL.
DASHBOARD_API_BASE_URL=http://127.0.0.1:3001/api

# Fail fast if the API is unreachable instead of hanging the dashboard render.
DASHBOARD_API_TIMEOUT_MS=5000

# Google Identity Services client ID for dashboard sign-in. The server-rendered
# login route reads this at container runtime, so Docker images remain portable.
# This should point to the same Google OAuth client used by the API.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Development-only fallback when the Nest API is offline.
# Uses the local test credentials: admin@example.com / Password123!
DASHBOARD_ALLOW_LOCAL_AUTH_FALLBACK=true
